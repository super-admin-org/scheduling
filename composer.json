    "description": "Task scheduling extension for super-admin",
    "type": "library",
    "keywords": ["super-admin", "task", "Scheduling"],
    "homepage": "https://github.com/super-admin-org/scheduling",
    "license": "MIT",
    "authors": [
        {
            "name": "super-admin",
            "email": "info@super-admin.org"
        }
